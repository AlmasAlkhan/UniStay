# Local development. Copy to backend/.env; never commit real secrets.
DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=local-development-only-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional locally; REQUIRED with DEBUG=false.
# DATABASE_URL=postgresql://unistay:CHANGE_ME@127.0.0.1:5432/unistay
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# Verification/reset links point to frontend routes that teammates must implement.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=UniStay <noreply@localhost>
# Set true only behind a trusted HTTPS reverse proxy.
TRUST_PROXY_HTTPS=false
